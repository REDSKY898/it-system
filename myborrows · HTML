<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>IT Helpdesk — การยืมของฉัน</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Sarabun', sans-serif; background: #f0f4f8; }
    .navbar { background: #7F77DD; padding: 14px 24px; display: flex; align-items: center; justify-content: space-between; }
    .navbar-brand { color: white; font-size: 18px; font-weight: 600; }
    .btn-back { background: rgba(255,255,255,0.2); color: white; border: none; padding: 6px 14px; border-radius: 8px; cursor: pointer; font-size: 13px; }
    .container { max-width: 700px; margin: 0 auto; padding: 24px 16px; }
    .card { background: white; border-radius: 16px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); margin-bottom: 16px; }
    .card-title { font-size: 15px; font-weight: 600; color: #1a1a1a; margin-bottom: 16px; padding-bottom: 10px; border-bottom: 0.5px solid #eee; }
    .borrow-item { border: 0.5px solid #eee; border-radius: 12px; padding: 16px; margin-bottom: 12px; }
    .borrow-item:last-child { margin-bottom: 0; }
    .borrow-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
    .borrow-id { font-family: monospace; font-size: 12px; color: #999; }
    .badge { font-size: 11px; padding: 3px 10px; border-radius: 20px; font-weight: 500; }
    .badge-pending { background: #FAEEDA; color: #633806; }
    .badge-approved { background: #E1F5EE; color: #085041; }
    .badge-returning { background: #E6F1FB; color: #0C447C; }
    .badge-returned { background: #f0f4f8; color: #666; }
    .borrow-device { font-size: 15px; font-weight: 600; color: #1a1a1a; margin-bottom: 6px; }
    .borrow-info { font-size: 12px; color: #666; display: flex; gap: 16px; flex-wrap: wrap; }
    .btn-return { margin-top: 12px; width: 100%; padding: 10px; background: #E6F1FB; color: #0C447C; border: none; border-radius: 10px; font-size: 14px; font-weight: 500; cursor: pointer; font-family: inherit; }
    .btn-return:hover { background: #cde0f5; }
    .empty { text-align: center; padding: 40px 20px; color: #999; font-size: 14px; }
    .loading { text-align: center; padding: 40px; color: #666; }

    /* Modal */
    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 100; align-items: center; justify-content: center; }
    .modal-overlay.show { display: flex; }
    .modal { background: white; border-radius: 16px; padding: 24px; width: 420px; max-width: 95vw; }
    .modal-title { font-size: 15px; font-weight: 600; color: #1a1a1a; margin-bottom: 16px; padding-bottom: 10px; border-bottom: 0.5px solid #eee; }
    .form-group { margin-bottom: 14px; }
    .form-label { font-size: 12px; font-weight: 500; color: #444; margin-bottom: 4px; display: block; }
    .form-input { width: 100%; padding: 9px 12px; border: 0.5px solid #ddd; border-radius: 8px; font-size: 13px; outline: none; font-family: inherit; }
    .form-input:focus { border-color: #7F77DD; }
    textarea.form-input { height: 70px; resize: none; }
    .modal-footer { display: flex; gap: 8px; justify-content: flex-end; margin-top: 16px; }
    .btn-cancel { padding: 9px 16px; background: #f0f4f8; color: #666; border: none; border-radius: 8px; cursor: pointer; font-size: 13px; font-family: inherit; }
    .btn-confirm { padding: 9px 16px; background: #7F77DD; color: white; border: none; border-radius: 8px; cursor: pointer; font-size: 13px; font-family: inherit; }
    #msg-modal { padding: 8px; border-radius: 8px; font-size: 12px; display: none; margin-top: 8px; text-align: center; }
    .msg-success { background: #E1F5EE; color: #085041; }
    .msg-error { background: #FCEBEB; color: #791F1F; }
  </style>
</head>
<body>

  <div class="navbar">
    <span class="navbar-brand">📦 การยืมของฉัน</span>
    <button class="btn-back" onclick="location.href='dashboard.html'">← กลับ</button>
  </div>

  <!-- Modal แจ้งคืน -->
  <div class="modal-overlay" id="return-modal">
    <div class="modal">
      <p class="modal-title">📬 แจ้งความต้องการคืนอุปกรณ์</p>
      <input type="hidden" id="return-borrow-id"/>
      <div class="form-group">
        <label class="form-label">วันที่จะนำมาคืน *</label>
        <input type="date" class="form-input" id="return-plan-date"/>
      </div>
      <div class="form-group">
        <label class="form-label">หมายเหตุ</label>
        <textarea class="form-input" id="return-note" placeholder="เช่น อุปกรณ์ปกติดี ไม่มีรอยขีดข่วน..."></textarea>
      </div>
      <div class="modal-footer">
        <button class="btn-cancel" onclick="closeReturnModal()">ยกเลิก</button>
        <button class="btn-confirm" onclick="submitReturn()">📬 แจ้งคืน</button>
      </div>
      <div id="msg-modal"></div>
    </div>
  </div>

  <div class="container">
    <div class="card">
      <p class="card-title">รายการยืมของฉัน</p>
      <div id="borrow-list"><div class="loading">⏳ กำลังโหลด...</div></div>
    </div>
  </div>

  <script>
    const GAS_URL = 'https://script.google.com/macros/s/AKfycbwRwYG6zliBbpSrQQzgTIVhFODMbe6Nfb5zG-AV_APAIuC-2HP2QJAb98FfKEYVC3vY/exec';
    const user = JSON.parse(localStorage.getItem('user') || '{}');
    if (!user.email) { location.href = 'index.html'; }

    const today = new Date().toISOString().split('T')[0];
    document.getElementById('return-plan-date').value = today;

    const STATUS_LABEL = {
      'pending': 'รอ Admin อนุมัติ',
      'approved': 'กำลังยืมอยู่',
      'returning': 'แจ้งคืนแล้ว รอ IT รับ',
      'returned': 'คืนแล้ว'
    };

    async function loadMyBorrows() {
      try {
        const res = await fetch(GAS_URL + '?action=getBorrows');
        const data = await res.json();
        if (!data.success) { showEmpty(); return; }

        // กรองเฉพาะของ user คนนี้
        const myBorrows = data.borrows
          .filter(b => b.borrower_email === user.email)
          .reverse(); // ล่าสุดก่อน

        if (!myBorrows.length) { showEmpty(); return; }

        const list = document.getElementById('borrow-list');
        list.innerHTML = myBorrows.map(b => {
          const badgeClass = 'badge-' + (b.status || 'pending');
          const statusLabel = STATUS_LABEL[b.status] || b.status;
          const canReturn = b.status === 'approved';
          const isReturning = b.status === 'returning';

          return `
            <div class="borrow-item">
              <div class="borrow-header">
                <span class="borrow-id">${b.borrow_id}</span>
                <span class="badge ${badgeClass}">${statusLabel}</span>
              </div>
              <p class="borrow-device">💻 ${b.device_id}</p>
              <div class="borrow-info">
                <span>📅 ยืม: ${formatDate(b.borrow_date)}</span>
                <span>📅 กำหนดคืน: ${formatDate(b.due_date)}</span>
                ${b.purpose ? `<span>📝 ${b.purpose}</span>` : ''}
              </div>
              ${canReturn ? `
                <button class="btn-return" onclick="openReturnModal('${b.borrow_id}')">
                  📬 แจ้งความต้องการคืนอุปกรณ์
                </button>` : ''}
              ${isReturning ? `
                <div style="margin-top:10px;padding:8px 12px;background:#E6F1FB;border-radius:8px;font-size:12px;color:#0C447C">
                  ⏳ แจ้งคืนแล้ว กำลังรอ IT รับอุปกรณ์
                </div>` : ''}
            </div>`;
        }).join('');

      } catch(e) {
        document.getElementById('borrow-list').innerHTML = '<div class="empty">❌ เกิดข้อผิดพลาด กรุณาลองใหม่</div>';
      }
    }

    function showEmpty() {
      document.getElementById('borrow-list').innerHTML = '<div class="empty">ไม่มีรายการยืม</div>';
    }

    function formatDate(dateVal) {
      if (!dateVal) return '-';
      try { return new Date(dateVal).toLocaleDateString('th-TH', { year: 'numeric', month: 'short', day: 'numeric' }); }
      catch(e) { return dateVal; }
    }

    function openReturnModal(borrowId) {
      document.getElementById('return-borrow-id').value = borrowId;
      document.getElementById('return-note').value = '';
      document.getElementById('return-plan-date').value = today;
      document.getElementById('msg-modal').style.display = 'none';
      document.getElementById('return-modal').classList.add('show');
    }

    function closeReturnModal() {
      document.getElementById('return-modal').classList.remove('show');
    }

    async function submitReturn() {
      const borrowId = document.getElementById('return-borrow-id').value;
      const planDate = document.getElementById('return-plan-date').value;
      const note = document.getElementById('return-note').value.trim();
      if (!planDate) { showModalMsg('กรุณาเลือกวันที่จะนำมาคืน', 'error'); return; }

      const btn = document.querySelector('#return-modal .btn-confirm');
      btn.disabled = true;
      btn.textContent = '⏳ กำลังส่ง...';

      try {
        const res = await fetch(GAS_URL, {
          method: 'POST',
          body: JSON.stringify({
            action: 'requestReturn',
            borrow_id: borrowId,
            return_plan_date: planDate,
            note: note,
            borrower_email: user.email
          })
        });
        const data = await res.json();
        if (data.success) {
          showModalMsg('✅ แจ้งคืนสำเร็จ IT จะติดต่อกลับเร็วๆ นี้', 'success');
          btn.textContent = '✅ ส่งแล้ว';
          setTimeout(() => { closeReturnModal(); loadMyBorrows(); }, 1500);
        } else {
          showModalMsg('❌ ' + data.message, 'error');
          btn.disabled = false;
          btn.textContent = '📬 แจ้งคืน';
        }
      } catch(e) {
        showModalMsg('❌ เกิดข้อผิดพลาด', 'error');
        btn.disabled = false;
        btn.textContent = '📬 แจ้งคืน';
      }
    }

    function showModalMsg(text, type) {
      const el = document.getElementById('msg-modal');
      el.style.display = 'block';
      el.className = type === 'success' ? 'msg-success' : 'msg-error';
      el.textContent = text;
    }

    loadMyBorrows();
  </script>

</body>
</html>
